# ==============================================================================
# Guidey (exortic AI) Root .gitignore
# ==============================================================================

# Private Data, Pitch Materials & Business Docs
data/
*.xlsx
*.csv
*.mp4

# Databases, SQLite & Hot State
*.db
*.sqlite
*.sqlite3
backend/data/
data/

# Dynamic Agent Memory, Tasks, Workspaces, and Prompt Cache
backend/agent/memory/
agent_memory/

# Temp Scripts, Dumps & Evaluation Logs
*.log
temp.log
generated_plans_evaluation.json
backend/scripts/
filetree.md
details.md

# Environment Variables & Secrets
.env
.env.*
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/

# Node.js / Next.js
node_modules/
.next/
out/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Supabase
supabase/.temp/
supabase/.branches/

# IDE, OS & Tooling
.vscode/
.idea/
.DS_Store
Thumbs.db
.agents/
.gemini/

# Local Docs, Legacy & Startup Scripts (Only README, frontend, and backend uploaded)
docs/
start.bat
legacy/
reset.py

